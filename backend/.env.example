# Database type: sqlite (local + free HF Spaces) or mysql
DB_TYPE=sqlite

# SQLite (default for local and free hosting)
SQLITE_FILE=./novel_app.db

# MySQL (optional — local XAMPP or cloud later)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql

# File uploads
UPLOAD_DIR=./uploads

