# Database type: sqlite (easy local) or mysql
DB_TYPE=sqlite

# MySQL Credentials (UPDATE WITH YOUR VALUES)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db

# Cloud MySQL (Railway) usually requires secure connection.
MYSQL_SSL_DISABLED=false

# SQL file inside backend/sql/ used for startup initialization when tables are missing.
MYSQL_INIT_SQL=setup_railway.sql

# File uploads
UPLOAD_DIR=./uploads

# Admin login
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=Ux3@f=7x2
ADMIN_TOKEN_EXPIRES_HOURS=24

# Token signing secret - replace in production.
JWT_SECRET=82543ee8aae0ba248616ced4a528763f56921b9385bf4bf6ff295047abaed097

# Optional but recommended for backend-verified Google sign-in.
# Set this to your Google OAuth client ID so the backend can verify token audience.
GOOGLE_CLIENT_ID=470949991659-g0e2qag6lsh4p9qtaaght65pal649aa8.apps.googleusercontent.com
